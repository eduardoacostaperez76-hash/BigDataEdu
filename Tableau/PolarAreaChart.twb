              <calculation class='tableau' formula='IF [accommodates] &lt;= 2 THEN &quot;1. Pequeña capacidad&quot;&#13;&#10;ELSEIF [accommodates] &lt;= 4 THEN &quot;2. Capacidad media&quot;&#13;&#10;ELSE &quot;3. Gran capacidad&quot;&#13;&#10;END' />
            </column>
            <column caption='Tipo de anfitrión' datatype='string' name='[Calculation_1076210460631040]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [host_is_superhost] = TRUE THEN &quot;Superhost&quot;&#13;&#10;ELSEIF [host_is_superhost] = FALSE THEN &quot;No Superhost&quot;&#13;&#10;ELSE &quot;Sin dato&quot;&#13;&#10;END' />
            </column>
            <column caption='Grupo de valoración' datatype='string' name='[Calculation_1076210460835841]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([review_scores_rating]) THEN &quot;Sin valoración&quot;&#13;&#10;ELSEIF [review_scores_rating] &lt; 4.2 THEN &quot;Menos de 4,2&quot;&#13;&#10;ELSEIF [review_scores_rating] &lt; 4.5 THEN &quot;4,2 - 4,49&quot;&#13;&#10;ELSEIF [review_scores_rating] &lt; 4.75 THEN &quot;4,5 - 4,74&quot;&#13;&#10;ELSEIF [review_scores_rating] &lt; 4.9 THEN &quot;4,75 - 4,89&quot;&#13;&#10;ELSE &quot;4,9 - 5&quot;&#13;&#10;END' />
            </column>
            <column caption='Grupo de opiniones' datatype='string' name='[Calculation_1076210460950530]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [number_of_reviews] = 0 THEN &quot;0 opiniones&quot;&#13;&#10;ELSEIF [number_of_reviews] &lt;= 5 THEN &quot;1-5 opiniones&quot;&#13;&#10;ELSEIF [number_of_reviews] &lt;= 20 THEN &quot;6-20 opiniones&quot;&#13;&#10;ELSEIF [number_of_reviews] &lt;= 50 THEN &quot;21-50 opiniones&quot;&#13;&#10;ELSEIF [number_of_reviews] &lt;= 100 THEN &quot;51-100 opiniones&quot;&#13;&#10;ELSE &quot;Más de 100 opiniones&quot;&#13;&#10;END' />
            </column>
            <column caption='Número de alojamientos' datatype='integer' name='[Calculation_1076210465976324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([id])' />
