      <aliases enabled='yes' />
      <column caption='Score_Precio' datatype='real' name='[Calculation_0266971673407488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF { FIXED : MAX([price]) } = { FIXED : MIN([price]) } THEN&#13;&#10;    1&#13;&#10;ELSE&#13;&#10;    (&#13;&#10;        { FIXED : MAX([price]) } - [price]&#13;&#10;    )&#13;&#10;    /&#13;&#10;    (&#13;&#10;        { FIXED : MAX([price]) } - { FIXED : MIN([price]) }&#13;&#10;    )&#13;&#10;END' />
      </column>
      <column caption='Score_Camas' datatype='real' name='[Calculation_0266971673640961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF { FIXED : MAX([beds]) } = { FIXED : MIN([beds]) } THEN&#13;&#10;    1&#13;&#10;ELSE&#13;&#10;    (&#13;&#10;        [beds] - { FIXED : MIN([beds]) }&#13;&#10;    )&#13;&#10;    /&#13;&#10;    (&#13;&#10;        { FIXED : MAX([beds]) } - { FIXED : MIN([beds]) }&#13;&#10;    )&#13;&#10;END' />
      </column>
      <column caption='Score_Resenas' datatype='real' name='[Calculation_0266971673710594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1, MAX(0, [review_scores_rating] / 5))' />
      </column>
      <column caption='Indicador de referencia' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_0266971673837571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100 * (&#13;&#10;    0.50 * [Calculation_0266971673407488]&#13;&#10;    + 0.30 * [Calculation_0266971673640961]&#13;&#10;    + 0.20 * [Calculation_0266971673710594]&#13;&#10;)' />
      </column>
      <column caption='Validez de datos' datatype='boolean' name='[Calculation_0266971678195716]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([price])&#13;&#10;AND [price] &gt; 0&#13;&#10;AND NOT ISNULL([beds])&#13;&#10;AND [beds] &gt; 0&#13;&#10;AND NOT ISNULL([review_scores_rating])&#13;&#10;AND [review_scores_rating] &gt; 0' />
      </column>
